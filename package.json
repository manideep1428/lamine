{
  "name": "lamine",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-static.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "convex": "convex dev",
    "sandbox:template": "e2b template build --name lamine-web --path sandbox",
    "deploy": "convex deploy && static-hosting upload --dist ./out --build --prod"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "blockly": "^13.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "convex": "^1.46.0",
    "e2b": "^2.51.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "openai": "^7.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
